# CareeAi backend environment.
#
# Copy to `backend/.env` for local work; set the same names in Render's dashboard
# for production. Every variable here is one the code actually reads — checked
# against `process.env` usage across backend/, so nothing in this list is
# decorative and nothing the app needs is missing from it.
#
# The variables under REQUIRED are asserted at boot by utils/env.ts: a production
# process that cannot satisfy them refuses to start rather than serving traffic
# in an unsafe state.

# ─── REQUIRED IN PRODUCTION ────────────────────────────────────────────────────

# Signs session tokens. Minimum 32 characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# The platform owner's passcode for the /admin console. Minimum 16 characters.
# Generate it the same way as JWT_SECRET — never reuse a value from this repo's
# git history, which is public.
ADMIN_SECRET=

# MongoDB Atlas connection string.
MONGODB_URI=

# ─── SERVER ───────────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# Facilities are all in India and their schedules (close-of-day, morning
# reminders) are stated in local time, not the hosting region's.
FACILITY_TIMEZONE=Asia/Kolkata

# ─── LOCAL DEVELOPMENT ONLY ───────────────────────────────────────────────────
# Both are refused in production by the boot check.

# Run against the in-memory store instead of Atlas. Everything is lost on
# restart — this exists so the project runs on a laptop that cannot reach Atlas.
USE_MOCK_DB=false

# Insert the demo facilities and staff on an empty database.
AUTO_SEED=false

# Pin the facility password AUTO_SEED writes. Without it a password is generated
# and printed to the log — which is the point of it, so only set this when a test
# run needs to know the value in advance.
SEED_FACILITY_PASSWORD=

# ─── IMAGE UPLOADS (ImageKit) ─────────────────────────────────────────────────
# Facility logos, cover images, gallery photos and doctor portraits. Optional:
# with these unset the branding fields fall back to a plain "paste a URL" box and
# /api/v1/uploads/config reports configured:false. All three are needed — partial
# configuration counts as unconfigured, never as half-working.
#
# From the ImageKit dashboard → Developer options → API keys.
# The private key signs uploads and must never reach the browser.

IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ─── LAB REPORT & INVOICE PDFs (Cloudflare R2) ───────────────────────────────
# Where lab report and patient billing/discharge invoice PDFs are stored and shared.
# Optional and independent of ImageKit: images can be switched on while reports are
# not. All four of the first block are required together.
#
# From the Cloudflare dashboard → R2 → Manage API tokens. The account id is in
# the R2 overview URL. The secret is shown once, at creation.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=careeai-reports

# Public domain for the bucket — either the r2.dev subdomain or a custom domain.
#
# Set it and share links are stable, which is what a WhatsApp message needs: a
# patient opening the chat next week still reaches their result. Leave it empty
# and the bucket is treated as private, so shares become signed URLs that expire
# after 24 hours — correct, but they die in the chat history.
R2_PUBLIC_BASE_URL=

# ─── WHATSAPP (Meta Cloud API) ────────────────────────────────────────────────
# Bookings, queue alerts and reminders. Optional — without them the chatbot and
# the outbound pings are inert, and nothing else is affected.
#
# NOTE: the access token expires. When replies stop arriving after the first
# message, this is almost always why — regenerate it in the Meta dashboard.

META_WHATSAPP_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
# Must equal the number META_PHONE_NUMBER_ID sends from, so send and receive
# happen on one number.
META_DISPLAY_NUMBER=
META_ACCESS_TOKEN=

# Legacy Twilio sandbox number, still read as a fallback display number.
TWILIO_WHATSAPP_NUMBER=

# ─── WEB PUSH ─────────────────────────────────────────────────────────────────
# Browser notifications. Generated into backend/vapid_keys.json on first boot if
# absent, so these are only needed to pin a pair across deploys (which you want
# in production — a regenerated pair silently invalidates every subscription).

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─── OBSERVABILITY ────────────────────────────────────────────────────────────

# error | warn | info | debug
LOG_LEVEL=info
# json | pretty
LOG_FORMAT=pretty
# Requests slower than this (ms) are logged as slow.
SLOW_REQUEST_MS=1000
# Set to 'strict' to make cross-tenant query attempts throw instead of warn.
TENANT_GUARD=
